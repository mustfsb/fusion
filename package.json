{
  "name": "opencode-fusion-council",
  "version": "0.1.0",
  "description": "Provider-agnostic multi-model council plugin and CLI for OpenCode.",
  "type": "module",
  "bin": {
    "fusion-council": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "install:opencode-commands": "node scripts/install-opencode-commands.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.17.4",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "REPOSITORY_URL"
  },
  "bugs": {
    "url": "REPOSITORY_URL/issues"
  },
  "homepage": "REPOSITORY_URL#readme",
  "license": "MIT"
}
