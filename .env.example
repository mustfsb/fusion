# Copy to .env or export these in your shell. Use only the keys required by your configured models.

# OpenAI or OpenAI-compatible gateways, including optional OpenRouter.
OPENAI_API_KEY=replace-with-openai-or-compatible-key
OPENCODE_GO_API_KEY=replace-with-opencode-go-compatible-key
OPENROUTER_API_KEY=replace-with-openrouter-key
DEEPSEEK_API_KEY=replace-with-deepseek-key

# Anthropic Messages API.
ANTHROPIC_API_KEY=replace-with-anthropic-key

# Google Gemini API.
GOOGLE_API_KEY=replace-with-google-key

# Optional: point the OpenCode plugin to a non-default config file.
FUSION_COUNCIL_CONFIG=./fusion-council.config.jsonc
